# Configuración del despliegue. Copiar a `deploy/.env` y rellenar.
#
# **Estos no son los secretos de `backend/.env`.** Aquel fichero está versionado
# —lo señala la auditoría del 2026-08-25 como SEC-01—, así que sus valores los
# tiene cualquiera con acceso al repositorio y no sirven para una instalación a
# la que entre gente. Genera unos nuevos:
#
#     openssl rand -base64 32

POSTGRES_DB=hacker_experience
POSTGRES_USER=hackaton
POSTGRES_PASSWORD=

# Firma los tokens de sesión. Si se filtra, cualquiera puede fabricar una sesión
# de cualquier jugador, administrador incluido.
JWT_SECRET=

# La cuenta de administrador, creada al arrancar si no existe.
ADMIN_LOGIN=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Dónde publica el frontend. El 4000 es el puerto que ya esperaba el túnel de
# Cloudflare, por eso es el valor por defecto.
HACKATON_BIND=0.0.0.0:4000

# Origenes que pueden llamar a la API desde otra pagina, separados por comas.
# **Dejalo vacio o sin poner.** En este despliegue nginx sirve el juego y hace
# de proxy de `/api`: el navegador ve un solo origen y CORS no interviene.
# CORS_ORIGINS=
