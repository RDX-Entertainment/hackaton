# Copiar a `backend/.env` antes del primer arranque. Ese fichero no se versiona: lo que
# hay aqui son huecos, no credenciales.

DATABASE_URL=postgres://postgres:change-me@127.0.0.1:5432/hacker_experience

# Firma los tokens de sesion. Generar uno propio, no dejar el de ejemplo:
#
#     openssl rand -base64 32
JWT_SECRET=change-this-before-running

HOST=127.0.0.1
PORT=8080

# Origenes que pueden llamar a la API desde otra pagina, separados por comas. Vacio
# significa ninguno, y es lo correcto en produccion: alli nginx sirve el front y hace de
# proxy de `/api`, asi que el navegador ve un solo origen y CORS ni entra en juego. Solo
# hace falta cuando el front vive aparte, que es el caso de Vite en desarrollo.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Solo desarrollo: reduce todas las colas a 3--5 segundos para probar la barra de progreso.
# PROCESS_TEST_SECONDS=4

# Cuenta de administrador, creada al arrancar si no existe. Cambiar la contrasena aunque
# sea local: es la misma puerta que hay publicada.
ADMIN_LOGIN=adm
ADMIN_EMAIL=adm@dev.demo
ADMIN_PASSWORD=change-this-too
